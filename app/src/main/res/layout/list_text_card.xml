<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/itemLayout"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingVertical="@dimen/marginNormal">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/itemCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/marginNormal"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?themePrimaryColor"
        app:cardBackgroundColor="?themeCardColor">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/itemText"
            style="?themeRegularFont"
            android:textColor="?themePrimaryColor"
            android:paddingVertical="@dimen/marginNormal"
            android:paddingStart="@dimen/marginPageNormal"
            android:paddingEnd="@dimen/marginPageNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </com.google.android.material.card.MaterialCardView>

</androidx.appcompat.widget.LinearLayoutCompat>
