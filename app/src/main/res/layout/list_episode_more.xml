<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/marginSmall"
    android:foreground="?selectableItemBackground">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/episodeMoreText"
        style="?themeSmallFont"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="..."
        android:gravity="center"
        android:textColor="?themeSecondaryColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/episodePrevButton"
        app:srcCompat="@drawable/ic_chevron_right"
        android:rotation="180"
        app:tint="?themeSecondaryColor"
        android:padding="@dimen/marginSmall"
        android:background="?selectableItemBackgroundBorderless"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="@id/episodeMoreText"
        app:layout_constraintBottom_toBottomOf="@id/episodeMoreText"
        app:layout_constraintEnd_toStartOf="@id/episodeMoreText" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/episodeNextButton"
        app:srcCompat="@drawable/ic_chevron_right"
        app:tint="?themeSecondaryColor"
        android:padding="@dimen/marginSmall"
        android:background="?selectableItemBackgroundBorderless"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="@id/episodeMoreText"
        app:layout_constraintBottom_toBottomOf="@id/episodeMoreText"
        app:layout_constraintStart_toEndOf="@id/episodeMoreText" />

</androidx.constraintlayout.widget.ConstraintLayout>
