<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/collapsedGroupCardBackground"
    app:cardBackgroundColor="?themeCardColor"
    app:cardCornerRadius="@dimen/cornerNormal"
    app:cardElevation="@dimen/elevationLow"
    android:foreground="?selectableItemBackground"
    android:layout_marginEnd="@dimen/marginNormal"
    android:layout_marginBottom="@dimen/marginNormal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/collapsedGroupIndicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:translationZ="1dp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/collapsedGroupCoverImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/collapsedGroupImageGuideline"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="2:3"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/collapsedGroupImageGuideline"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="@fraction/listImageRatio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Franchise Name -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/collapsedGroupTitleText"
            style="?themeRegularClickableBoldFont"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/collapsedGroupImageGuideline"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/marginSmall"
            android:layout_marginHorizontal="@dimen/marginNormal"
            android:foreground="?selectableItemBackground"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <!-- Series count badge -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/collapsedGroupCountText"
            style="?themeSmallFont"
            app:layout_constraintTop_toBottomOf="@id/collapsedGroupTitleText"
            app:layout_constraintStart_toStartOf="@id/collapsedGroupTitleText"
            android:layout_marginTop="@dimen/marginClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Layers icon to indicate collapsed -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/collapsedGroupIcon"
            app:srcCompat="@drawable/ic_layers"
            app:layout_constraintStart_toEndOf="@id/collapsedGroupCountText"
            app:layout_constraintTop_toTopOf="@id/collapsedGroupCountText"
            app:layout_constraintBottom_toBottomOf="@id/collapsedGroupCountText"
            android:layout_marginStart="@dimen/marginSmall"
            android:layout_width="16dp"
            android:layout_height="16dp"/>

        <!-- Average Score -->
        <LinearLayout
            android:id="@+id/collapsedGroupScoreLayout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/collapsedGroupImageGuideline"
            android:layout_marginStart="@dimen/marginNormal"
            android:layout_marginBottom="@dimen/marginNormal"
            android:gravity="center_vertical|start"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/collapsedGroupScoreIcon"
                app:srcCompat="@drawable/ic_star_filled"
                android:layout_marginEnd="@dimen/marginClose"
                android:layout_width="@dimen/iconSmallSize"
                android:layout_height="@dimen/iconSmallSize"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/collapsedGroupScoreText"
                style="?themeRegularClickableFont"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/collapsedGroupScoreLabel"
                style="?themeSmallFont"
                android:text=" avg"
                android:layout_marginStart="@dimen/marginClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
