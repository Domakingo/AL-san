<resources>

    <!-- ============================================== -->
    <!-- Parent Theme - Material Design 3 Inspired     -->
    <!-- ============================================== -->

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">?themePrimaryColor</item>
        <item name="colorPrimaryDark">?themePrimaryColor</item>
        <item name="colorAccent">?themePrimaryColor</item>
        <item name="android:windowBackground">?themeBackgroundColor</item>
        <item name="android:statusBarColor">?themeBackgroundColor</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:overScrollMode">never</item>
        <item name="android:fontFamily">@font/sourcesanspro_regular</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogTheme</item>
        <item name="themeAppNameFont">@style/FontAppName</item>
        <item name="themeTitleFont">@style/FontTitle</item>
        <item name="themeRegularFont">@style/FontRegular</item>
        <item name="themeRegularBoldFont">@style/FontRegularBold</item>
        <item name="themeRegularClickableFont">@style/FontRegularClickable</item>
        <item name="themeRegularClickableBoldFont">@style/FontRegularClickableBold</item>
        <item name="themeRegularNegativeFont">@style/FontRegularNegative</item>
        <item name="themeSmallFont">@style/FontSmall</item>
        <item name="themeSmallBoldFont">@style/FontSmallBold</item>
        <item name="themeSmallClickableFont">@style/FontSmallClickable</item>
        <item name="themeSmallNegativeFont">@style/FontSmallNegative</item>
        <item name="themeBigFont">@style/FontBig</item>
        <item name="themeBigBoldFont">@style/FontBigBold</item>
        <item name="themePrimaryButton">@style/ButtonPrimary</item>
        <item name="themePrimaryBorderButton">@style/ButtonPrimaryBorder</item>
        <item name="themeNegativeBorderButton">@style/ButtonNegativeBorder</item>
        <item name="themeRegularCheckBox">@style/CheckBoxTheme</item>
        <item name="colorBackgroundFloating">?themeCardColor</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearanceSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearanceMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearanceLarge</item>
        <item name="materialCardViewStyle">@style/CardStyle</item>
    </style>

    <!-- Shape Appearances - Material Design 3 -->
    <style name="ShapeAppearanceSmall" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/cornerSmall</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="ShapeAppearanceMedium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/cornerNormal</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="ShapeAppearanceLarge" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">@dimen/cornerLarge</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <!-- Card Style - Modern Elevated -->
    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/cornerNormal</item>
        <item name="cardElevation">@dimen/elevationLow</item>
        <item name="strokeWidth">0dp</item>
    </style>
    
    <!-- ============================================== -->
    <!-- AniList Light Theme Variants                  -->
    <!-- ============================================== -->

    <style name="AniListLightAppTheme">
        <item name="themeBackgroundColor">@color/anilistPaleWhite</item>
        <item name="themeBackgroundTransparent86Color">@color/anilistPaleWhiteTransparent86</item>
        <item name="themeBackgroundTransparent50Color">@color/anilistPaleWhiteTransparent50</item>
        <item name="themeBackgroundTransparent36Color">@color/anilistPaleWhiteTransparent36</item>
        <item name="themeCardColor">@color/anilistWhite</item>
        <item name="themeCardTransparentColor">@color/anilistWhiteTransparent80</item>
        <item name="themeDividerColor">@color/anilistDarkBlueTransparent12</item>
        <item name="themeContentColor">@color/anilistDarkBlue</item>
        <item name="themeContentTransparentColor">@color/anilistDarkBlueTransparent36</item>
        <item name="android:statusBarColor">?themeBackgroundColor</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AniListDarkAppTheme">
        <item name="themeBackgroundColor">@color/anilistVeryDeepBlue</item>
        <item name="themeBackgroundTransparent86Color">@color/anilistVeryDeepBlueTransparent86</item>
        <item name="themeBackgroundTransparent50Color">@color/anilistVeryDeepBlueTransparent50</item>
        <item name="themeBackgroundTransparent36Color">@color/anilistVeryDeepBlueTransparent36</item>
        <item name="themeCardColor">@color/anilistDeepBlue</item>
        <item name="themeCardTransparentColor">@color/anilistDeepBlueTransparent80</item>
        <item name="themeDividerColor">@color/anilistDarkWhiteTransparent12</item>
        <item name="themeContentColor">@color/anilistDarkWhite</item>
        <item name="themeContentTransparentColor">@color/anilistDarkWhiteTransparent36</item>
        <item name="android:statusBarColor">?themeBackgroundColor</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.ThemeAniListLightBlue" parent="AniListLightAppTheme">
        <item name="themePrimaryColor">@color/deepBlue</item>
        <item name="themeSecondaryColor">@color/deepBlueSecondary</item>
        <item name="themeSecondaryTransparent50Color">@color/deepBlueSecondaryTransparent50</item>
        <item name="themeSecondaryTransparent20Color">@color/deepBlueSecondaryTransparent20</item>
        <item name="themeNegativeColor">@color/dangerRed</item>
        <item name="themeNegativeTransparent50Color">@color/dangerRedTransparent50</item>
    </style>

    <style name="AppTheme.ThemeAniListLightPurple" parent="AniListLightAppTheme">
        <item name="themePrimaryColor">@color/deepPurple</item>
        <item name="themeSecondaryColor">@color/deepPurpleSecondary</item>
        <item name="themeSecondaryTransparent50Color">@color/deepPurpleSecondaryTransparent50</item>
        <item name="themeSecondaryTransparent20Color">@color/deepPurpleSecondaryTransparent20</item>
        <item name="themeNegativeColor">@color/dangerRed</item>
        <item name="themeNegativeTransparent50Color">@color/dangerRedTransparent50</item>
    </style>

    <style name="AppTheme.ThemeAniListLightGreen" parent="AniListLightAppTheme">
        <item name="themePrimaryColor">@color/deepGreen</item>
        <item name="themeSecondaryColor">@color/deepGreenSecondary</item>
        <item name="themeSecondaryTransparent50Color">@color/deepGreenSecondaryTransparent50</item>
        <item name="themeSecondaryTransparent20Color">@color/deepGreenSecondaryTransparent20</item>
        <item name="themeNegativeColor">@color/dangerRed</item>
        <item name="themeNegativeTransparent50Color">@color/dangerRedTransparent50</item>
    </style>

    <style name="AppTheme.ThemeAniListLightPink" parent="AniListLightAppTheme">
        <item name="themePrimaryColor">@color/deepPink</item>
        <item name="themeSecondaryColor">@color/deepPinkSecondary</item>
        <item name="themeSecondaryTransparent50Color">@color/deepPinkSecondaryTransparent50</item>
        <item name="themeSecondaryTransparent20Color">@color/deepPinkSecondaryTransparent20</item>
        <item name="themeNegativeColor">@color/dangerRed</item>
        <item name="themeNegativeTransparent50Color">@color/dangerRedTransparent50</item>
    </style>

    <style name="AppTheme.ThemeAniListLightYellow" parent="AniListLightAppTheme">
        <item name="themePrimaryColor">@color/deepYellow</item>
        <item name="themeSecondaryColor">@color/deepYellowSecondary</item>
        <item name="themeSecondaryTransparent50Color">@color/deepYellowSecondaryTransparent50</item>
        <item name="themeSecondaryTransparent20Color">@color/deepYellowSecondaryTransparent20</item>
        <item name="themeNegativeColor">@color/dangerRed</item>
        <item name="themeNegativeTransparent50Color">@color/dangerRedTransparent50</item>
    </style>

    <!-- ============================================== -->
    <!-- AniList Dark Theme Variants                   -->
    <!-- ============================================== -->

    <style name="AppTheme.ThemeAniListDarkBlue" parent="AniListDarkAppTheme">
        <item name="themePrimaryColor">@color/pastelBlue</item>
        <item name="themeSecondaryColor">@color/pastelBlueSecondary</item>
        <item name="themeSecondaryTransparent50Color">@color/pastelBlueSecondaryTransparent50</item>
        <item name="themeSecondaryTransparent20Color">@color/pastelBlueSecondaryTransparent20</item>
        <item name="themeNegativeColor">@color/dangerRed</item>
        <item name="themeNegativeTransparent50Color">@color/dangerRedTransparent50</item>
    </style>

    <style name="AppTheme.ThemeAniListDarkPurple" parent="AniListDarkAppTheme">
        <item name="themePrimaryColor">@color/pastelPurple</item>
        <item name="themeSecondaryColor">@color/pastelPurpleSecondary</item>
        <item name="themeSecondaryTransparent50Color">@color/pastelPurpleSecondaryTransparent50</item>
        <item name="themeSecondaryTransparent20Color">@color/pastelPurpleSecondaryTransparent20</item>
        <item name="themeNegativeColor">@color/dangerRed</item>
        <item name="themeNegativeTransparent50Color">@color/dangerRedTransparent50</item>
    </style>

    <style name="AppTheme.ThemeAniListDarkGreen" parent="AniListDarkAppTheme">
        <item name="themePrimaryColor">@color/pastelGreen</item>
        <item name="themeSecondaryColor">@color/pastelGreenSecondary</item>
        <item name="themeSecondaryTransparent50Color">@color/pastelGreenSecondaryTransparent50</item>
        <item name="themeSecondaryTransparent20Color">@color/pastelGreenSecondaryTransparent20</item>
        <item name="themeNegativeColor">@color/dangerRed</item>
        <item name="themeNegativeTransparent50Color">@color/dangerRedTransparent50</item>
    </style>

    <style name="AppTheme.ThemeAniListDarkPink" parent="AniListDarkAppTheme">
        <item name="themePrimaryColor">@color/pastelPink</item>
        <item name="themeSecondaryColor">@color/pastelPinkSecondary</item>
        <item name="themeSecondaryTransparent50Color">@color/pastelPinkSecondaryTransparent50</item>
        <item name="themeSecondaryTransparent20Color">@color/pastelPinkSecondaryTransparent20</item>
        <item name="themeNegativeColor">@color/dangerRed</item>
        <item name="themeNegativeTransparent50Color">@color/dangerRedTransparent50</item>
    </style>

    <style name="AppTheme.ThemeAniListDarkYellow" parent="AniListDarkAppTheme">
        <item name="themePrimaryColor">@color/pastelYellow</item>
        <item name="themeSecondaryColor">@color/pastelYellowSecondary</item>
        <item name="themeSecondaryTransparent50Color">@color/pastelYellowSecondaryTransparent50</item>
        <item name="themeSecondaryTransparent20Color">@color/pastelYellowSecondaryTransparent20</item>
        <item name="themeNegativeColor">@color/dangerRed</item>
        <item name="themeNegativeTransparent50Color">@color/dangerRedTransparent50</item>
    </style>

    <!-- ============================================== -->
    <!-- Typography Styles - Material Design 3         -->
    <!-- ============================================== -->

    <style name="FontAppName">
        <item name="android:fontFamily">@font/ubuntu_medium</item>
        <item name="android:textSize">@dimen/fontBig</item>
        <item name="android:textColor">?themePrimaryColor</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="FontTitle">
        <item name="android:fontFamily">@font/ubuntu_medium</item>
        <item name="android:textSize">@dimen/fontBig</item>
        <item name="android:textColor">?themeContentColor</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    
    <style name="FontRegular">
        <item name="android:fontFamily">@font/sourcesanspro_regular</item>
        <item name="android:textSize">@dimen/fontNormal</item>
        <item name="android:textColor">?themeContentColor</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="FontRegularBold">
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:textSize">@dimen/fontNormal</item>
        <item name="android:textColor">?themeContentColor</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="FontRegularClickable">
        <item name="android:fontFamily">@font/sourcesanspro_regular</item>
        <item name="android:textSize">@dimen/fontNormal</item>
        <item name="android:textColor">?themePrimaryColor</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="FontRegularClickableBold">
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:textSize">@dimen/fontNormal</item>
        <item name="android:textColor">?themePrimaryColor</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="FontRegularNegative">
        <item name="android:fontFamily">@font/sourcesanspro_regular</item>
        <item name="android:textSize">@dimen/fontNormal</item>
        <item name="android:textColor">?themeNegativeColor</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="FontSmall">
        <item name="android:fontFamily">@font/sourcesanspro_regular</item>
        <item name="android:textSize">@dimen/fontSmall</item>
        <item name="android:textColor">?themeContentColor</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="FontSmallBold">
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:textSize">@dimen/fontSmall</item>
        <item name="android:textColor">?themeContentColor</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="FontSmallClickable">
        <item name="android:fontFamily">@font/sourcesanspro_regular</item>
        <item name="android:textSize">@dimen/fontSmall</item>
        <item name="android:textColor">?themePrimaryColor</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="FontSmallNegative">
        <item name="android:fontFamily">@font/sourcesanspro_regular</item>
        <item name="android:textSize">@dimen/fontSmall</item>
        <item name="android:textColor">?themeNegativeColor</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="FontBig">
        <item name="android:fontFamily">@font/sourcesanspro_regular</item>
        <item name="android:textSize">@dimen/fontLarge</item>
        <item name="android:textColor">?themeContentColor</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="FontBigBold">
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:textSize">@dimen/fontLarge</item>
        <item name="android:textColor">?themeContentColor</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Label Style for smaller text -->

    <!-- ============================================== -->
    <!-- Button Styles - Material Design 3 Pills       -->
    <!-- ============================================== -->

    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">?themePrimaryColor</item>
        <item name="android:textColor">?themeBackgroundColor</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/cornerFull</item>
        <item name="android:paddingHorizontal">@dimen/marginBig</item>
        <item name="android:minHeight">@dimen/buttonMinHeight</item>
        <item name="rippleColor">?themeBackgroundTransparent36Color</item>
    </style>

    <style name="ButtonPrimaryBorder" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeWidth">@dimen/lineWidth</item>
        <item name="strokeColor">?themePrimaryColor</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">?themePrimaryColor</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/cornerFull</item>
        <item name="android:paddingHorizontal">@dimen/marginBig</item>
        <item name="android:minHeight">@dimen/buttonMinHeight</item>
        <item name="rippleColor">?themePrimaryColor</item>
    </style>

    <style name="ButtonNegativeBorder" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeWidth">@dimen/lineWidth</item>
        <item name="strokeColor">?themeNegativeColor</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">?themeNegativeColor</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/cornerFull</item>
        <item name="android:paddingHorizontal">@dimen/marginBig</item>
        <item name="android:minHeight">@dimen/buttonMinHeight</item>
        <item name="rippleColor">?themeNegativeColor</item>
    </style>

    <!-- Text Button Style -->

    <!-- Tonal Button (Filled Tonal) -->

    <!-- ============================================== -->
    <!-- Component Styles                              -->
    <!-- ============================================== -->

    <style name="CheckBoxTheme" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="buttonCompat">@drawable/checkbox_circular</item>
        <item name="android:buttonTint">?themePrimaryColor</item>
    </style>

    <style name="PopupTheme" parent="Theme.AppCompat.DayNight">
        <item name="android:colorBackground">?themeCardColor</item>
        <item name="android:textColor">?themeContentColor</item>
    </style>
    
    <!-- Bottom Sheet - Modern MD3 Style -->
    <style name="BottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetModalTheme</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" if-api="v28">shortEdges</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="BottomSheetModalTheme" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/shape_bottom_sheet_background</item>
        <item name="android:backgroundTint">?themeCardColor</item>
    </style>

    <!-- Card Styles -->
    <style name="ColorCircleCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">@dimen/iconSize</item>
        <item name="android:layout_height">@dimen/iconSize</item>
        <item name="cardCornerRadius">@dimen/cornerNormal</item>
        <item name="strokeColor">?themeContentColor</item>
        <item name="strokeWidth">@dimen/lineWidth</item>
    </style>

    <!-- Elevated Card Style -->

    <!-- Outlined Card Style -->

    <!-- Chip Style -->

    <!-- Divider Style -->


    <!-- Bottom Navigation Active Indicator (MD3 Pill) -->
    <style name="BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearanceIndicator</item>
    </style>

    <style name="ShapeAppearanceIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Tab Style -->
    <style name="TabTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:textSize">@dimen/fontSmall</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?themeContentColor</item>
    </style>

</resources>
